# ─────────────────────────────────────────────────────────────────────────
# Vega API environment variables
#
# Cloudflare Workers (wrangler) uses `.dev.vars`; Vercel uses the dashboard's
# "Environment Variables". You only need the section relevant to your platform.
# ─────────────────────────────────────────────────────────────────────────

# ── Shared (required everywhere) ─────────────────────────────────────────
# AES-256-GCM key. MUST be a 64-char hex string. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Vercel / Neon (required ONLY on Vercel) ──────────────────────────────
# Engine selector (Waline-style, see https://waline.js.org/guide/database.html):
#   "postgres" / "neon" / "pg"  → Neon   (PostgreSQL)
#   "d1" / "sqlite"             → D1     (SQLite)
# If omitted, the engine is auto-detected from the connection string below.
DATABASE=postgres
# Postgres/Neon connection string. Waline uses `PGURL`; `DATABASE_URL` and
# `POSTGRES_URL` are also accepted (the Vercel/Neon integration often injects
# `DATABASE_URL`). Only one connection variable is needed.
PGURL=
# Aliases (equivalent to PGURL):
# DATABASE_URL=
# POSTGRES_URL=
# Alternative: libpq-style split connection (Waline also supports these):
# PGHOST=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGPORT=5432
# Optional: explicit deployment platform: "vercel" | "cloudflare".
# If omitted, it is auto-detected (VERCEL env var / presence of D1 binding).
DEPLOYMENT_PLATFORM=

# ── Optional ─────────────────────────────────────────────────────────────
# Fallback client API key (used when no key is configured in the admin panel).
OPENAI_API_KEY=
# Google tool-call routing mode: "ai-sdk" (default) | "direct".
VEGA_GOOGLE_TOOL_MODE=
